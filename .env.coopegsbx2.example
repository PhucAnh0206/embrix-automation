# NetSuite environment (coopegsbx2). Copy to .env.coopegsbx2 (git-ignored) and fill in; never commit the copy.
# ns.ps1 / ns-cycle.ps1 load it for their own run only. See netsuite-suite/README.md and netsuite-suite\docs\NEXT-RUN.md §0.
TEST_ENV=coopegsbx2
EMBRIX_BASE_URL=https://core-ui.coopegsbx2.embrix.org/
GRAPHQL_URL=https://service-transactional.coopegsbx2.embrix.org/graphql
# Core UI login of a QA user on coopegsbx2
EMBRIX_USER=
EMBRIX_PASSWORD=
# Clock-moving cases (INV-010, ns-06) run only with true; every step puts the clock back
NS_ALLOW_CLOCK=false
# Database of this environment (coopegsbx-dev-db / coredb), dev-preprod VPN on
DB_HOST=
DB_PORT=5432
DB_NAME=coredb
DB_USER=
DB_PASSWORD=
DB_SSL=true
# QA mailbox (EMAIL_INVOICE goes only here)
NOTIFY_IMAP_HOST=
NOTIFY_IMAP_USER=
NOTIFY_IMAP_PASSWORD=
NOTIFY_EMAIL_TO=
# NetSuite sandbox, view only (shared CoopeG tester account; ask Anh / Coope, never answer its security-questions prompt)
NS_SANDBOX_URL=https://8754760-sb1.app.netsuite.com/
NS_SANDBOX_USER=
NS_SANDBOX_PASSWORD=
NS_SANDBOX_QA=
# QA mailbox the test customers get (EMAIL_INVOICE, notifications)
QA_EMAIL=
