# Dependencies
node_modules/

# Auth state — contains credentials, never commit
playwright/.auth/

# Environment variables — contains secrets
.env
# Per-env sources of truth for switch-env.ps1 (contain real credentials).
# The active one gets copied to .env by the switcher.
.env.dev
.env.preprod
.env.prod
.env.production
.env.staging
.env.local
.env.bak
.env.coopeg
.env.congero
.env.coopegsbx2

# Everything a run writes: output/test-results(-<tenant>), playwright-report, artifacts (evidence and
# handoff files that must survive a run - Playwright clears test-results), run-logs, pw-cache, NetSuite state.
output/
# The same folders from before 2026-11-04, when they sat in the repo root.
test-results/
test-results-*/
artifacts/
playwright-report/
run-logs/
# Captured console output from local runs (full-run.log, verify-*.log, etc.)
*.log

# Scratch space for ad-hoc transpiled helpers used while debugging.
.tmpx/

# OS files
.DS_Store
Thumbs.db

# test examples
tests/examples/

# documents
#docs/personals/
# Working backups (*.bak-YYYY-MM-DD). Never commit these - this repo is public,
# and git history is the real backup anyway.
*.bak
*.bak-*
*.orig
.env.congero-oci
.env.oci-dev
.pw-cache/

# run-projects.ps1 / ns.ps1: one run per tenant (exists only while a run is going)
.run-lock.*
.ns-demo-state.json

# NetSuite suite copy (netsuite-suite/): run output and local DB configs stay local
netsuite-suite/results/
netsuite-suite/evidence/
netsuite-suite/eft-106/evidence/
**/.pg-*.json
.ns-last-run.json
