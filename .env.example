# Jasec Embrix — Automation Test Environment
# Copy this file to .env and fill in your values.
# DO NOT commit .env to Git.

# ── Target environment ─────────────────────────────────────────────────
# Selects which environment defaults to use. Currently only 'jasec-dev'.
TEST_ENV=jasec-dev

# ── Base URLs ──────────────────────────────────────────────────────────
# Optional overrides. If unset, defaults from TEST_ENV apply.
EMBRIX_BASE_URL=https://core-ui.jasec-dev.embrix.org/
SELFCARE_BASE_URL=https://selfcare-ui.jasec-dev.embrix.org/
GRAPHQL_URL=https://service-transactional.jasec-dev.embrix.org/graphql

# ── Credentials (Embrix Core UI + Self Care admin) ─────────────────────
EMBRIX_USER=your-username
EMBRIX_PASSWORD=your-password

# ── JASEC core DB (used by DbHelper for tests that seed/read state) ────
# Requires VPN + SSL. Same connection DBeaver uses.
# Only required for tests that call dbHelper (e.g. TS-03 TC 3.2 debt setup,
# and the balance-verification scaffolding when re-enabled).
DB_HOST=your-db-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=coredb-jasec-dev
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_SSL=require

# ── Notification tests / IMAP (TS-01, JEPYP-230) ───────────────────────
# Only needed for `npm run test:notification:jasec`. See docs/NOTIFICATION_TESTS.md.
#
# NOTE: switch-env.ps1 copies .env.dev / .env.preprod over .env, so add these
# to the per-env file you actually use, not just to .env.
#
# Reads a REAL mailbox rather than a mail catcher on purpose — the JEPYP-230
# work was blocked by an SMTP transport defect (no STARTTLS, JavaMail pinned to
# TLSv1). A catcher bypassing the tenant's SMTP server would have hidden it.
#
# Google Workspace / Gmail: imap.gmail.com:993 with an APP PASSWORD (not the
# account password) — needs 2FA on the account and app passwords allowed by the
# Workspace admin.
# Microsoft 365: basic-auth IMAP is disabled by Microsoft; use a Gmail test
# mailbox or add an OAuth2 flow. (This is us READING mail — unrelated to the
# tenant's own SMTP being Office 365.)
NOTIFY_IMAP_HOST=imap.gmail.com
NOTIFY_IMAP_PORT=993
NOTIFY_IMAP_USER=your-test-mailbox@example.com
NOTIFY_IMAP_PASSWORD=your-app-password

# Address written onto the test account's billing contact. Usually the same as
# NOTIFY_IMAP_USER; plus-addressing (you+jasec@gmail.com) also works and keeps
# notification mail filterable.
NOTIFY_EMAIL_TO=your-test-mailbox@example.com

# Folders to search, comma-separated. Include Spam — a policy change that
# reroutes JASEC mail there is indistinguishable from a delivery failure.
NOTIFY_SEARCH_FOLDERS=INBOX,[Gmail]/Spam

# ── JEPYP-230 tenant config (notification suites) ──────────────────────
# These are the only tenant-specific values in the notification code. Switching
# environment should be a change HERE and in the DB_* / URL block above —
# nothing in helpers/ or test-data/ should need editing.
#
# Prepaid energy price offer, 2nd arg to get_correspondence_data. Drives
# `minimumtopupamount` (X), which sets every balance band. A wrong id does not
# error, it just returns a different X — so verify it per environment:
#   SELECT id, name FROM core_pricing.price_offer WHERE servicetype = 'ENERGY';
JASEC_PRICE_OFFER_ID=P-100008

# Balance thresholds Event 3 fires on. Tenant policy config, not tariff law.
# (The 100 / 280 kWh tax boundaries are ARESEP law and are NOT configurable.)
JASEC_THRESHOLD_BASE=-2000
JASEC_THRESHOLD_HIGH=-4000

# ── JASEC CCP baseline (top-up + account-creation suites) ──────────────
# Date the jasecCcpBaseline auto-fixture parks the tenant CCP clock at before
# each JASEC test, so no test inherits a month-B clock left behind by a
# cross-month test.
#
# The clock is TENANT-GLOBAL and frozen, so this is a shared resource: if the
# tenant is parked ahead of this value every reset is a rewind, which
# ServerHelper warns about and which the runbook says can corrupt cycle state.
# The date-sensitive specs (TS-02 TC 2.1/2.10, TS-03) pin absolute dates in the
# same month, so change them together with this.
#
# Specs that own the clock themselves opt out with test.use({ ccpBaseline: null })
# rather than overriding this.
# JASEC_CCP_BASELINE=2026-07-15

# How long to wait for an email, and how often to re-check.
NOTIFY_WAIT_TIMEOUT_MS=180000
NOTIFY_POLL_INTERVAL_MS=5000

# ── Log settings ───────────────────────────────────────────────────────
# When true, wipes test-results/logs/ before each run.
CLEAN_LOGS_ON_START=true

# ── Debug (optional) ───────────────────────────────────────────────────
# Slows down Playwright actions by N ms — useful when watching in --headed.
# SLOW_MO=250
