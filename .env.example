# Embrix CoreUI — Automation Test Environment
# Copy this file to .env and fill in your values
# DO NOT commit .env to Git

# ── Target environment ─────────────────────────────────────────────────
# Options: dev | qa | staging
TEST_ENV=sandbox

# ── Base URL override (optional — overrides TEST_ENV if set) ───────────
 EMBRIX_BASE_URL=https://core-ui.congero.embrix.org

# ── Credentials ────────────────────────────────────────────────────────
EMBRIX_USER=your.user@domain.com
EMBRIX_PASSWORD=your_password_here

# ── API Bearer Token ───────────────────────────────────────────────────
EMBRIX_API_BEARER_TOKEN=your_jwt_bearer_token_here

# ── Log Settings ───────────────────────────────────────────────────────
# Set to true to automatically delete old log files under test-results/logs/ before each run
CLEAN_LOGS_ON_START=true

# Database Configuration
DB_HOST = embrix-rds-dev-db.chg5bgdk4yyp.us-east-1.rds.amazonaws.com
DB_PORT = 5432
DB_NAME = coredb-congero
DB_USER = ebrxadmin
